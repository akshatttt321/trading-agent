# Copy to .env and fill in. NEVER commit .env. NEVER paste these into a chat.

# --- LLM ---------------------------------------------------------------------
# Gemini (default, FREE tier): aistudio.google.com -> Get API key -> Create API key
GEMINI_API_KEY=
# OpenAI (optional verifier): platform.openai.com -> API keys. NOTE: ChatGPT Go/Plus subscriptions do NOT include API access.
OPENAI_API_KEY=
# Anthropic (optional): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Hyperliquid (perps + spot) -----------------------------------------------
# Use an API WALLET, not your main wallet key:
#   app.hyperliquid.xyz -> More -> API -> Generate. API wallets can trade but
#   CANNOT withdraw. Put the API wallet's private key here and your main
#   account address in HL_ACCOUNT_ADDRESS.
HL_API_WALLET_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=

# --- Polymarket (prediction markets) ------------------------------------------
# Needs a Polygon wallet holding USDC.e with the CTF exchange approved.
# POLY_SIGNATURE_TYPE: 0 = EOA wallet, 1 = Magic/email login, 2 = browser proxy wallet
# POLY_FUNDER: the address that holds the USDC (proxy address for types 1/2)
POLY_PRIVATE_KEY=
POLY_SIGNATURE_TYPE=0
POLY_FUNDER=

# --- Live-trading acknowledgement ---------------------------------------------
# The agent REFUSES to start in mode=live unless this exact string is present.
# LIVE_TRADING_ACK=I_UNDERSTAND_THIS_IS_REAL_MONEY_AND_I_CAN_LOSE_ALL_OF_IT

# --- Alerts (optional) --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard (agent/api.py behind Caddy) -----------------------------------
# Long random token the UI sends as "Authorization: Bearer ...". Generate: openssl rand -hex 24
DASHBOARD_TOKEN=
# Public hostname Caddy gets a Let's Encrypt cert for. With no domain use sslip.io: 1-2-3-4.sslip.io for IP 1.2.3.4
DASHBOARD_HOST=
# Origin of the deployed UI (GitHub Pages) so browsers allow the calls. "*" also works.
DASHBOARD_ORIGIN=https://akshat43121.github.io

# --- Dashboard admin login (Google sign-in) ------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
#   Authorized JavaScript origins: https://akshat43121.github.io   (and http://localhost:8766 for local testing)
# Only this Google account may change settings / secrets / mode from the dashboard.
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=sakshat1905@gmail.com

# --- Watchdog email alerts (Gmail SMTP) --------------------------------------
# Create a Gmail App Password: myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
ALERT_EMAIL=sakshat1905@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sakshat1905@gmail.com
SMTP_APP_PASSWORD=
WD_AUTO_RESTART=true
